{
  "fallbackRuleId": "CG_DEFAULT_ORDER",
  "rules": [
    {"id":"CG_JUSSIVE_MARK","action":"SELECT","form":"que","target":{"upos":"SCONJ"},"context":[{"atStart":true},{"finalForm":"!"},{"offset":1,"upos":["VERB"],"feats":{"Mood":"Sub"}}],"note":"marcador de ordem jussiva antes de subjuntivo sem sujeito expresso","example":"Que venha!"},
    {"id":"CG_JUSSIVE_VERB","action":"SELECT","target":{"upos":"VERB","feats":{"Mood":"Sub"}},"context":[{"offset":-1,"upos":["SCONJ"]},{"finalForm":"!"}],"note":"subjuntivo em oração jussiva marcada","example":"Que venha!"},
    {"id":"CG_NAME_SEQUENCE","action":"SELECT","target":{"upos":"PROPN","excludeIfAnyUpos":["PRON","DET"]},"context":[{"offset":1,"upos":["PROPN"],"capitalized":true}],"note":"duas palavras com inicial maiúscula podem formar um nome próprio","example":"São Paulo"},
    {"id":"CG_NAME_CONTINUATION","action":"SELECT","target":{"upos":"PROPN","excludeIfAnyUpos":["PRON","DET"]},"context":[{"offset":-1,"upos":["PROPN"],"capitalized":true}],"note":"continuação de nome próprio composto","example":"São Paulo"},
    {"id":"CG_DET_NOUN","action":"SELECT","target":{"upos":"DET"},"context":[{"offset":1,"upos":["NOUN","ADJ","NUM","PROPN"]}],"note":"determinante precede núcleo nominal","example":"a menina"},
    {"id":"CG_REMOVE_VERB_AFTER_DET","action":"REMOVE","target":{"upos":"VERB"},"context":[{"offset":-1,"upos":["DET"]}],"note":"homógrafo verbal após determinante perde a leitura de verbo","example":"o corte"},
    {"id":"CG_NOUN_AFTER_DET","action":"SELECT","target":{"upos":"NOUN"},"context":[{"offset":-1,"upos":["DET","NUM"]}],"note":"núcleo nominal depois de determinante","example":"o corte"},
    {"id":"CG_REL_AFTER_NOUN","action":"SELECT","target":{"upos":"PRON","feats":{"PronType":"Rel"}},"context":[{"offset":-1,"upos":["NOUN","PROPN"]}],"note":"relativo depois de antecedente nominal","example":"livro que li"},
    {"id":"CG_REL_ADV_AFTER_NOUN","action":"SELECT","target":{"upos":"ADV","feats":{"PronType":"Rel"}},"context":[{"offset":-1,"upos":["NOUN","PROPN"]}],"note":"advérbio relativo depois de antecedente nominal","example":"casa onde moro"},
    {"id":"CG_COMP_AFTER_VERB","action":"SELECT","target":{"upos":"SCONJ"},"context":[{"offset":-1,"upos":["VERB","AUX"]},{"offset":1,"upos":["PRON","DET","NOUN","VERB"]}],"note":"complementizador após verbo matriz","example":"disse que eu iria"},
    {"id":"CG_COND_INITIAL","action":"SELECT","form":"se","target":{"upos":"SCONJ"},"context":[{"atStart":true},{"offset":1,"upos":["PRON","DET","NOUN","VERB"]}],"note":"conjunção condicional inicial diante de oração","example":"se ele vier"},
    {"id":"CG_ADP_INFINITIVE","action":"SELECT","target":{"upos":"ADP"},"context":[{"offset":1,"upos":["VERB"],"feats":{"VerbForm":"Inf"}}],"note":"preposição antes de infinitivo","example":"começo a trabalhar"},
    {"id":"CG_ADP_BETWEEN_VERBS","action":"SELECT","target":{"upos":"ADP"},"context":[{"offset":-1,"upos":["VERB","AUX"]},{"offset":1,"upos":["VERB"]}],"note":"preposição entre verbo matriz e infinitivo","example":"começo a trabalhar"},
    {"id":"CG_PRON_BEFORE_FINITE","action":"SELECT","target":{"upos":"PRON","feats":{"Clitic":"Yes"}},"context":[{"offset":1,"upos":["VERB","AUX"],"feats":{"VerbForm":"Fin"}}],"note":"clítico antes de verbo finito","example":"o vejo"},
    {"id":"CG_INT_ADV_INITIAL","action":"SELECT","target":{"upos":"ADV","feats":{"PronType":"Int"}},"context":[{"atStart":true},{"finalForm":"?"}],"note":"advérbio interrogativo em pergunta direta","example":"como você faz?"},
    {"id":"CG_TEMP_CONJ_INITIAL","action":"SELECT","target":{"upos":"SCONJ"},"context":[{"atStart":true},{"containsForm":","}],"note":"conjunção em oração subordinada inicial separada por vírgula","example":"quando ele chegar, sairemos"},
    {"id":"CG_SUB_FUT_AFTER_MARK","action":"SELECT","target":{"upos":"VERB","feats":{"Mood":"Sub","Tense":"Fut"}},"context":[{"offset":-2,"upos":["SCONJ"]},{"offset":-1,"upos":["PRON","NOUN"]}],"note":"forma homógrafa do infinitivo é futuro do subjuntivo após marcador e sujeito","example":"quando ele chegar"},
    {"id":"CG_ADP_AFTER_NOUN_BEFORE_NP","action":"SELECT","target":{"upos":"ADP"},"context":[{"offset":-1,"upos":["NOUN"]},{"offset":1,"upos":["DET","PRON"]}],"note":"sintagma preposicional após nome e antes de complemento","example":"livro para a menina"},
    {"id":"CG_NOUN_AFTER_ADP","action":"SELECT","target":{"upos":"NOUN"},"context":[{"offset":-1,"upos":["ADP"]}],"note":"núcleo nominal depois de preposição","example":"de ajuda"},
    {"id":"CG_NOUN_OBJECT_FINAL","action":"SELECT","target":{"upos":"NOUN"},"context":[{"offset":-1,"upos":["VERB","ADV"]},{"offset":1,"upos":["PUNCT"]}],"note":"nome no fim da oração após verbo ou advérbio","example":"ensina português"},
    {"id":"CG_ADV_AFTER_VERB","action":"SELECT","target":{"upos":"ADV"},"context":[{"offset":-1,"upos":["VERB","AUX"]}],"note":"advérbio após verbo finito","example":"anda devagar"},
    {"id":"CG_COP_PREDICATIVE","action":"SELECT","target":{"upos":"AUX","lemmaClass":"COPULA"},"context":[{"offset":1,"upos":["ADJ","NOUN"]}],"note":"cópula diante de predicativo não verbal","example":"a casa é grande"},
    {"id":"CG_COP_SCAN_PREDICATIVE","action":"SELECT","target":{"upos":"AUX","lemmaClass":"COPULA"},"context":[{"offset":1,"maxDistance":4,"upos":["ADJ","NOUN"],"barrier":["VERB","AUX","ADP","SCONJ","CCONJ","PUNCT"]}],"source":"https://edu.visl.dk/cg3/chunked/contexts.html; https://universaldependencies.org/u/dep/cop.html","note":"varredura até predicativo não verbal através de advérbios, bloqueada por fronteira oracional e preposição","example":"A casa foi muito bonita."},
    {"id":"CG_COP_PARTICIPIAL_ADJECTIVE","action":"SELECT","target":{"upos":"ADJ"},"context":[{"offset":-1,"upos":["AUX"]}],"source":"https://universaldependencies.org/u/dep/cop.html; https://universaldependencies.org/pt/index.html","note":"predicativo adjetival após cópula prevalece sobre leitura de particípio verbal homógrafo","example":"Eu corri porque estava cansado."},
    {"id":"CG_COP_NOMINAL","action":"SELECT","target":{"upos":"AUX","lemmaClass":"COPULA"},"context":[{"offset":1,"upos":["DET"]},{"offset":2,"upos":["NOUN"]}],"note":"cópula diante de predicativo nominal com determinante","example":"ele é um professor"},
    {"id":"CG_MOTION_PAST_INFINITIVE","action":"SELECT","target":{"upos":"VERB","lemmaClass":"MOTION","feats":{"Tense":"Past"}},"context":[{"offset":1,"upos":["VERB"],"feats":{"VerbForm":"Inf"}}],"source":"https://universaldependencies.org/pt/index.html; https://edu.visl.dk/cg3/chunked/contexts.html","note":"forma passada de verbo de movimento antes de infinitivo mantém leitura lexical de deslocamento","example":"Eles foram trabalhar cedo."},
    {"id":"CG_AUX_INFINITIVE","action":"SELECT","target":{"upos":"AUX"},"context":[{"offset":1,"upos":["VERB"],"feats":{"VerbForm":"Inf"}}],"note":"auxiliar diante de infinitivo","example":"vamos estudar"},
    {"id":"CG_VERB_AFTER_SUBJECT","action":"SELECT","target":{"upos":"VERB"},"context":[{"offset":-1,"upos":["PRON","NOUN","PROPN"]}],"note":"verbo finito depois de sujeito","example":"ela ajuda"},
    {"id":"CG_VERB_BEFORE_OBJECT","action":"SELECT","target":{"upos":"VERB"},"context":[{"offset":1,"upos":["DET","NOUN","PRON"]}],"note":"verbo antes de complemento nominal","example":"ajuda crianças"}
  ]
}
