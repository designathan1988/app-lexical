      "relation": "advmod",
      "semanticRole": "degree",
      "source": "https://universaldependencies.org/u/dep/advmod.html; https://github.com/amrisi/amr-guidelines/blob/master/amr.md#degree",
      "note": "o advérbio de grau depende do modificador adjacente e o grau modifica esse conceito no grafo",
      "example": "Nós saímos tão cedo."
    },
    {
      "id": "SEM_VERBAL_DEGREE",
      "class": "VERBAL_DEGREE",
      "headUpos": [],
