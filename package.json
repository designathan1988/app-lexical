{
  "name": "lexical-semantic-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Compilador semântico de domínio para português que opera um pagebuilder através de uma representação intermediária tipada e validada.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run tests/benchmark.test.ts",
    "test:report": "vitest run --reporter=json --outputFile=public/test-report.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
